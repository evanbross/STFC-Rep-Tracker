# Copy this file to .env and fill in your values.
# .env is gitignored and should never be committed.

# PostgreSQL connection strings (from Neon dashboard or your DB provider)
# Use the pooled URL for normal app operation
# Use the direct URL for running migrations
DATABASE_URL_POOLED=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@HOST-direct/DBNAME?sslmode=require

# Set to 'development', 'production', or 'testing'
FLASK_ENV=development

# Flask secret key. With FLASK_ENV=production the app refuses to start
# unless this is a random value of 16+ characters; placeholders like the one below fail.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-in-production

# Caddy reverse proxy — registers this app as http://stfc.localhost
# Requires the shared infra stack (cd ../infra && docker-compose up -d) to be running.
CADDY_ADMIN_URL=http://localhost:3019
CADDY_APP_NAME=stfc

# Test database — a disposable Neon *branch* (never the live database).
# pytest creates a throwaway schema per run inside it and drops it afterwards.
# A pooled (-pooler) URL is converted to the direct endpoint automatically.
DATABASE_URL_TEST=postgresql://USER:PASSWORD@TEST-BRANCH-HOST/DBNAME?sslmode=require
