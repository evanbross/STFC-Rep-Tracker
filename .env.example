# Copy this file to .env and fill in your values.
# .env is gitignored and should never be committed.

# PostgreSQL connection strings (from Neon dashboard or your DB provider)
# Use the pooled URL for normal app operation
# Use the direct URL for running migrations
DATABASE_URL_POOLED=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@HOST-direct/DBNAME?sslmode=require

# Set to 'development', 'production', or 'testing'
FLASK_ENV=development

# Flask secret key — set a long random string in production
SECRET_KEY=change-me-in-production

# Caddy reverse proxy — registers this app as http://stfc-rep-tracker.localhost
# Requires the shared infra stack (cd ../infra && docker-compose up -d) to be running.
CADDY_ADMIN_URL=http://localhost:2019
CADDY_APP_NAME=stfc-rep-tracker